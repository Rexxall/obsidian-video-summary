{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.9.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["activeTab", "clipboardWrite", "contextMenus", "scripting", "storage"],
  "host_permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_extName__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture_current_video": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_cmdCapture__"
    },
    "append_current_video": {
      "description": "__MSG_cmdAppend__"
    },
    "queue_current_video": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "MacCtrl+Z"
      },
      "description": "__MSG_cmdQueue__"
    },
    "open_batch_view": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+S"
      },
      "description": "__MSG_cmdBatch__"
    },
    "copy_timestamp_link": {
      "description": "__MSG_cmdCopy__"
    },
    "queue_selected_link": {
      "description": "__MSG_cmdQueueLink__"
    }
  },
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
