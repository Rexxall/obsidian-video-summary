# Video Summary backend settings. The start script copies this file to .env and fills in
# VS_WEBHOOK_TOKEN; it also asks for the API keys if they are empty. After editing .env, run the
# start script again to apply the change.

# --- Connection (filled in automatically) ---
VS_WEBHOOK_TOKEN=
VS_PORT=5678

# --- Model for summaries: any OpenAI-compatible service ---
# DeepSeek (default):  https://api.deepseek.com                            deepseek-flash
# SiliconFlow:         https://api.siliconflow.cn/v1                       deepseek-ai/DeepSeek-V4.1-Flash
# Qwen (DashScope):    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# Kimi:                https://api.moonshot.cn/v1                          (model name from the Kimi console)
# Gemini (optional):   https://generativelanguage.googleapis.com/v1beta/openai   gemini-flash-latest
VS_CHAT_BASE_URL=https://api.deepseek.com
VS_CHAT_API_KEY=
VS_CHAT_MODEL=deepseek-flash

# --- Speech-to-text for videos without subtitles and for local audio/video ---
# SiliconFlow SenseVoice is free; any OpenAI-compatible /audio/transcriptions service works.
VS_SPEECH_BASE_URL=https://api.siliconflow.cn/v1
VS_SPEECH_API_KEY=
VS_SPEECH_MODEL=FunAudioLLM/SenseVoiceSmall

# --- Reading local images (optional; defaults to the speech service and key above) ---
VS_VISION_BASE_URL=
VS_VISION_API_KEY=
VS_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# --- Network ---
# auto: download the prebuilt image; if that fails, build it here, with mainland-China mirrors
# when Docker Hub is unreachable. cn: always build here with those mirrors. global: no mirrors.
VS_MIRROR=auto
# Optional proxy for YouTube and other blocked sites, for example http://host.docker.internal:7890
VS_HTTP_PROXY=
TZ=Asia/Shanghai
